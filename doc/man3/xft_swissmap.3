.Dd October 14, 2026
.Dt XFT_SWISSMAP 3
.Os xft
.Sh NAME
.Nm xft_new_swissmap ,
.Nm xft_new_swissmap_with ,
.Nm xft_swissmap_insert ,
.Nm xft_swissmap_lookup ,
.Nm xft_swissmap_delete ,
.Nm xft_swissmap_clear ,
.Nm xft_swissmap_destroy
.Nd open addressing hash map from byte keys to pointers
.Sh SYNOPSIS
.In swissmap.h
.Fd #define SWISS_INITIAL_SIZE 512
.Ft t_swissmap
.Fn xft_new_swissmap "t_allocator allocator"
.Ft t_swissmap
.Fn xft_new_swissmap_with "t_allocator allocator" "t_size capacity"
.Ft t_result
.Fn xft_swissmap_insert "t_allocator allocator" "t_swissmap *restrict map" "t_buffer key" "t_u8 *restrict value"
.Ft t_any
.Fn xft_swissmap_lookup "const t_swissmap *restrict map" "t_buffer key"
.Ft void
.Fn xft_swissmap_delete "t_swissmap *restrict map" "t_buffer key"
.Ft void
.Fn xft_swissmap_clear "t_swissmap *restrict map"
.Ft void
.Fn xft_swissmap_destroy "t_allocator allocator" "t_swissmap *restrict map"
.Sh DESCRIPTION
A
.Vt t_swissmap
is a SwissTable style hash map.
Keys are arbitrary byte strings given as
.Vt t_buffer ;
values are non-null pointers.
.Bd -literal -offset indent
typedef struct s_swissmap {
	t_soa	soa;
	t_size	count;		/* live entries */
	t_size	tombstones;	/* deleted slots not yet reclaimed */
} t_swissmap;
.Ed
.Pp
Slots are kept in a
.Vt t_soa
with three columns: a one byte control array, the keys and the values.
Slots are grouped by the width of the host's preferred SIMD vector, 64, 32,
16 or 8 bytes depending on the ISA the library was built for, and each probe
compares a whole group of control bytes at once.
.Pp
Keys are hashed with
.Fn xft_xxh3_64bits
using seed 0.
The hash modulo the number of groups picks the first group, and its top
7 bits are stored in the control byte.
Probing is linear, one group at a time, and a lookup stops at the first
group that contains an empty slot.
Two keys are equal when they have the same size and the same bytes.
.Pp
The map stores the
.Vt t_buffer
and the value pointer as given.
It does not copy or free the key bytes or the value; both must stay valid,
and the key bytes unchanged, while the entry is in the map.
.Pp
.Fn xft_new_swissmap_with
creates an empty map with
.Fa capacity
slots.
.Fa capacity
must be a nonzero multiple of the group width.
.Fn xft_new_swissmap
is
.Fn xft_new_swissmap_with
with
.Dv SWISS_INITIAL_SIZE .
.Pp
.Fn xft_swissmap_insert
maps
.Fa key
to
.Fa value .
If the key is already present, both its stored key buffer and its value are
replaced and
.Fa count
is unchanged.
Otherwise the entry goes in the first empty or deleted slot along the probe
sequence.
.Pp
Before probing, if live entries plus tombstones reach 85% of the capacity,
the map is rebuilt into a new allocation.
The new capacity is double the old one when live entries are at least
42.5% of the capacity; otherwise it is the same, and the rebuild only
discards tombstones.
The old storage is then freed.
.Pp
.Fn xft_swissmap_lookup
returns the value stored for
.Fa key .
.Pp
.Fn xft_swissmap_delete
removes
.Fa key
if present.
If the slot's group still contains an empty slot the slot is marked empty;
otherwise it becomes a tombstone, counted in
.Fa tombstones ,
which a later insert may reuse.
.Pp
.Fn xft_swissmap_clear
marks every slot empty and resets
.Fa count
and
.Fa tombstones ,
keeping the allocation.
It does nothing on a map with no storage.
.Pp
.Fn xft_swissmap_destroy
frees the storage and zeroes
.Fa *map .
.Pp
The map has no iteration interface and no defined order.
Value pointers returned by
.Fn xft_swissmap_lookup
are the caller's own pointers and are not affected by rehashing.
.Sh RETURN VALUES
.Fn xft_new_swissmap
and
.Fn xft_new_swissmap_with
return the new map.
If
.Fa capacity
is zero or not a multiple of the group width, or the allocation fails, they
return a zeroed map whose
.Fa soa Ns .ptr
is
.Dv nullptr .
.Pp
.Fn xft_swissmap_insert
returns
.Dv OK
on success and
.Dv KO
if a required rebuild could not allocate, in which case the map is
unchanged.
.Pp
.Fn xft_swissmap_lookup
returns the value pointer, or
.Dv nullptr
if
.Fa key
is not present.
.Sh NOTES
.Dv SWISS_INITIAL_SIZE
is guarded by
.Ic #ifndef ,
but
.Fn xft_new_swissmap
is compiled into the library, so overriding it only takes effect when the
library itself is built with the new value.
.Pp
A rebuild may be triggered by an insert that only overwrites an existing
key.
.Sh EXAMPLES
.Bd -literal -offset indent
#include <xft.h>

t_result	demo(t_allocator a)
{
	t_swissmap	m;
	int			val;
	int			*got;

	m = xft_new_swissmap(a);
	if (m.soa.ptr == nullptr)
		return (KO);
	val = 42;
	if (!xft_swissmap_insert(a, &m,
			xft_fatptr((t_u8 *)"key1", 4), (t_u8 *)&val))
		return (xft_swissmap_destroy(a, &m), KO);
	got = xft_swissmap_lookup(&m, xft_fatptr((t_u8 *)"key1", 4));
	xft_pin_invariant(got != nullptr && *got == 42);
	xft_swissmap_delete(&m, xft_fatptr((t_u8 *)"key1", 4));
	xft_pin_invariant(xft_swissmap_lookup(&m,
			xft_fatptr((t_u8 *)"key1", 4)) == nullptr);
	xft_swissmap_destroy(a, &m);
	return (OK);
}
.Ed
.Sh SEE ALSO
.Xr xft_alloc 3 ,
.Xr xft_hash 3 ,
.Xr xft_indexmap 3 ,
.Xr xft_soa 3 ,
.Xr xft 7
.Sh CAVEATS
.Fn xft_swissmap_lookup
and
.Fn xft_swissmap_delete
divide by the number of groups, so calling them on a map whose creation
failed is undefined behavior.
.Fn xft_swissmap_insert
on such a map returns
.Dv KO .
.Pp
.Fn xft_swissmap_destroy
treats a
.Dv nullptr
.Fa allocator Ns .allocator
as unreachable.
