.Dd November 17, 2026
.Dt XFT_STR 3
.Os xft
.Sh NAME
.Nm xft_new_str ,
.Nm xft_str_destroy ,
.Nm xft_str_extend ,
.Nm xft_str_reserve ,
.Nm xft_str_push_back ,
.Nm xft_str_remove
.Nd growable NUL-terminated byte string
.Sh SYNOPSIS
.In xft/str.h
.Ft t_result
.Fn xft_new_str "t_allocator allocator" "t_str *str" "t_size size"
.Ft void
.Fn xft_str_destroy "t_allocator allocator" "t_str *str"
.Ft t_result
.Fn xft_str_extend "t_allocator allocator" "t_str *restrict str" "const t_u8 *restrict mem" "t_size n"
.Ft t_result
.Fn xft_str_reserve "t_allocator allocator" "t_str *restrict str" "t_size n"
.Ft t_result
.Fn xft_str_push_back "t_allocator allocator" "t_str *restrict str" "const t_u8 byte"
.Ft t_result
.Fn xft_str_remove "t_str *restrict v" "t_size i"
.Sh DESCRIPTION
A
.Vt t_str
is a heap byte string that keeps a NUL byte after its contents.
The allocator is not stored; the caller passes the same one to every call
that may allocate or free.
.Bd -literal -offset indent
typedef struct s_str {
	t_buffer_with_capacity	buf;
} t_str;
.Ed
.Pp
.Fa buf Ns .size
is the number of bytes in use, excluding the NUL, and
.Fa buf Ns .capacity
the number of bytes allocated, including the NUL.
.Pp
.Fn xft_new_str
allocates
.Fa size
+ 1 bytes, stores a NUL at
.Fa buf Ns .mem Ns [0]
and writes the empty string to
.Fa *str .
.Fa buf Ns .capacity
is the size of the buffer returned by the allocator, which may exceed the
request.
.Pp
.Fn xft_str_destroy
frees the buffer and zeroes
.Fa *str .
.Pp
.Fn xft_str_extend
appends
.Fa n
bytes from
.Fa mem .
It copies
.Fa n
+ 1 bytes, so the byte at
.Fa mem Ns Bq Fa n
becomes the new terminator; it must be readable and should be NUL.
If the result does not fit, it first calls
.Fn xft_str_reserve
with
.Fa n .
.Pp
.Fn xft_str_reserve
asks the allocator to reallocate the buffer to
.Fa buf Ns .capacity
+
.Fa n
+ 1 bytes.
.Fa n
is added to the current capacity, not to the length, and the reallocation
is performed even if the space is already available.
.Pp
.Fn xft_str_push_back
appends
.Fa byte
and writes a new terminator after it.
When
.Fa buf Ns .size
+ 1 reaches
.Fa buf Ns .capacity ,
it first calls
.Fn xft_str_reserve
with twice the capacity, or 4 if the capacity is zero, which requests
roughly three times the old capacity.
.Pp
.Fn xft_str_remove
deletes the byte at index
.Fa i
and shifts the rest of the string, terminator included, down by one.
It never reallocates.
.Pp
No function shrinks the buffer.
Any call that may grow it can move
.Fa buf Ns .mem ,
invalidating pointers into the string.
.Sh RETURN VALUES
.Fn xft_new_str
returns
.Dv OK
on success.
If
.Fa size
is zero or the allocation fails it returns
.Dv KO ,
with
.Dv xft_err_inval
or
.Dv xft_err_oom
respectively, and leaves
.Fa *str
untouched.
.Pp
.Fn xft_str_extend ,
.Fn xft_str_reserve
and
.Fn xft_str_push_back
return
.Dv OK
on success and
.Dv KO
with
.Dv xft_err_oom
if the allocator could not grow the buffer, in which case the string is
unchanged.
.Pp
.Fn xft_str_remove
returns
.Dv KO
with
.Dv xft_err_inval
if
.Fa i
is not less than
.Fa buf Ns .size ,
and
.Dv OK
otherwise.
.Sh NOTES
Allocations and reallocations pass
.Dv __GCC_CONSTRUCTIVE_SIZE ,
the target's cache line size, as the allocator's alignment argument.
.Pp
.Xr xft_cstr 3
provides
.Fn xft_cstr_to_str ,
which builds a
.Vt t_str
from a C string.
.Sh EXAMPLES
.Bd -literal -offset indent
#include <xft/xft.h>

t_result	demo(t_allocator a)
{
	t_str	s;

	if (!xft_new_str(a, &s, 1).ok)
		return ((t_result){.ok = KO});
	if (!xft_str_extend(a, &s, (const t_u8 *)"abc", 3).ok
		|| !xft_str_push_back(a, &s, 'd').ok)
		return (xft_str_destroy(a, &s), (t_result){.ok = KO});
	xft_pin_invariant(xft_str_remove(&s, 1).ok);
	/* s.buf.mem is "acd", s.buf.size is 3 */
	xft_pin_invariant(!xft_str_remove(&s, 5).ok);
	xft_str_destroy(a, &s);
	return ((t_result){.ok = OK});
}
.Ed
.Sh SEE ALSO
.Xr xft_alloc 3 ,
.Xr xft_cstr 3 ,
.Xr xft_mem 3 ,
.Xr xft_vec 3 ,
.Xr xft 7
.Sh CAVEATS
Every function other than
.Fn xft_new_str
treats a
.Dv nullptr
.Fa buf Ns .mem
as unreachable, so none may be called on a string whose creation failed
or that was already destroyed.
.Fn xft_str_destroy ,
.Fn xft_str_reserve
and
.Fn xft_str_push_back
likewise treat a
.Dv nullptr
.Fa allocator Ns .allocator
as unreachable.
.Pp
.Fn xft_str_extend
reads one byte past
.Fa n ;
appending from a buffer that is not NUL-terminated at
.Fa mem Ns Bq Fa n
leaves the string unterminated.
