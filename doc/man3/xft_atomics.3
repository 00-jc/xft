.Nd mutexes, signals, futexes, ring buffers, spin backoff and memory fences
.Sh SYNOPSIS
.In atomics.h
.Ft void
.Fn xft_thread_fence "t_xft_atomic_ordering memorder"
.Ft void
.Fn xft_signal_fence "t_xft_atomic_ordering memorder"
